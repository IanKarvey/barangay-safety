# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# APK / release outputs
*.apk
*.ipa
*.aab

# Node modules (jimp tool used for icon generation)
node_modules/
package.json
package-lock.json
make_padded_icon.mjs

# Android signing keys (never commit these)
android/key.properties
*.jks
*.keystore

# Supabase SQL files with policies
supabase_rls_policies.sql

# Claude Code local runtime state
.claude/scheduled_tasks.lock

# Supabase CLI local cache — machine-specific, not source
supabase/.temp/

# Local APK share directory (build output, not source)
dist/

# Firebase Hosting deploy cache — regenerated on every `firebase deploy`
.firebase/

# ── Secrets and machine-specific config: never commit ──
# Build-time keys (copy env.example.json to env.json)
env.json
.env
.env.*
# Generated by `flutterfire configure` for your own Firebase project
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
.firebaserc
# Android signing
android/key.properties
*.jks
*.keystore
# Editor / AI-assistant local state
.claude/
